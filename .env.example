# Configuration Com'pagnons - Copier ce fichier vers .env et remplir les valeurs

# API Gemini - REQUIS
GEMINI_API_KEY=votre_cle_api_ici

# Configuration de l'environnement
NODE_ENV=development              # development ou production
API_BASE_URL=http://localhost:3000
PORT=3000

# Configuration de l'application
MAX_CONVERSATION_LENGTH=50        # Nombre maximum de messages dans l'historique
ENABLE_DEBUG_LOGS=true           # Activer les logs de débogage
LOG_LEVEL=info                   # debug, info, warn, error

# Configuration de l'API
API_TIMEOUT=30000                # Timeout des requêtes API (ms)
MAX_TOKENS=2048                  # Limite de tokens par réponse
TEMPERATURE=0.7                  # Température pour la génération

# Sécurité
ALLOWED_ORIGINS=http://localhost:8000,https://ori20030511.github.io
RATE_LIMIT=100                   # Requêtes par heure par IP